# Build artifacts
/build/
build/
build-asan/
build-ci-test/
build-debug/
build-ubsan/

# Generated stress baseline
tests/stress/bench_baseline.tc

# Untracked local scratch (optional); curated examples/ is versioned
examples/local/
# AOT default output next to .tc (tc-aot writes <input>.c)
examples/**/*.c
# AOT --run linked executables (tc-aot writes <input>.c.out)
examples/**/*.c.out

# macOS
.DS_Store

# AOT 输出（tc-aot 默认把 <input>.c / <input>.c.out 写在 .tc 旁边）
# 仅忽略用例目录下的产物；tests/unit/**/*.c 是受版本控制的单测源码，不受影响
tests/valid/*.c
tests/valid/*.c.out
tests/errors/**/*.c
tests/errors/**/*.c.out
tests/modules/*.c
tests/modules/*.c.out
tests/stress/*.c
tests/stress/*.c.out
