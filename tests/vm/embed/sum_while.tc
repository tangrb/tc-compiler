; TC-Embed 测试：ptr_load 多偏移常量求和
#lib
public func sum_three(data: ptr<int32>) int32 then
    var a: int32 = ptr_load(int32, data)
    var p1: ptr<int32> = ptr_add(int32, data, 1)
    var b: int32 = ptr_load(int32, p1)
    var p2: ptr<int32> = ptr_add(int32, data, 2)
    var c: int32 = ptr_load(int32, p2)
    var s1: int32 = add(int32, a, b)
    var total: int32 = add(int32, s1, c)
    return total
end
