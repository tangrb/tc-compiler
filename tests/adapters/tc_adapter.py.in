#!/usr/bin/env python3
"""LEX/SYN harness adapter for the TC 0.0.46 front-end.

Generated by CMake from tests/adapters/tc_adapter.py.in; the tool paths are the
ones built in this build tree.  The adapter never guesses compiler output: it
runs `tc-vm --syntax-only` (the partial LEX/SYN check) and parses the stable
diagnostic line

    <file>:<line>:<column>: error[<STAGE>]: <CODE>: <PRINT_NAME>

Tool cases use `@source` as the placeholder for the case source file.
"""

from __future__ import annotations

import os
import random
import re
import subprocess

TC_VM = r"@TC_VM_PATH@"
TC_AOT = r"@TC_AOT_PATH@"
REPO_ROOT = r"@CMAKE_SOURCE_DIR@"

DIAG_RE = re.compile(
    r"^(?P<file>.*):(?P<line>[0-9]+):(?P<column>[0-9]+): "
    r"error\[(?P<stage>LEX|SYN|IMPORT|SEM|CT)\]: "
    r"(?P<code>TC_(?:CE|RE)_[A-Z0-9_]+): (?P<name>[^:\n]*)$"
)
LEX_SYN_CODES = {
    "TC_CE_SYNTAX",
    "TC_CE_MISSING_END",
    "TC_CE_MODULE_LAYER",
    "TC_CE_MISSING_VISIBILITY",
    "TC_CE_PROGRAM_MODE_MISUSE",
    "TC_CE_VAR_MISSING_INIT",
    "TC_CE_LITERAL_LEX_RANGE",
}


def _tool_path(argv0):
    if argv0 == "tc-vm":
        return TC_VM
    if argv0 == "tc-aot":
        return TC_AOT
    return argv0


def _run(argv, timeout):
    return subprocess.run(
        argv,
        cwd=os.getcwd(),
        capture_output=True,
        timeout=timeout,
        env={"LC_ALL": "C", "LANG": "C", "TZ": "UTC",
             "PATH": os.environ.get("PATH", "/usr/bin:/bin")},
    )


NOTE_RE = re.compile(
    r"^(?P<file>.*):(?P<line>[0-9]+):(?P<column>[0-9]+): "
    r"note: related position$"
)
OFFSET_NOTE_RE = re.compile(
    r"^(?P<file>.*):(?P<line>[0-9]+):(?P<column>[0-9]+): "
    r"note: invalid byte offset (?P<offset>[0-9]+)$"
)
RT_RE = re.compile(
    r"^(?P<file>.*):(?P<line>[0-9]+):(?P<column>[0-9]+): "
    r"error\[RT\]: (?P<code>TC_RE_[A-Z0-9_]+): (?P<name>[^:\n]*)$"
)


def _strict_diagnostics(text, case, mode):
    """Parse stderr strictly.

    Syntax mode accepts LEX/SYN diagnostics and an optional UTF-8 byte-offset
    note (the additional position) but no related notes.  Static mode accepts
    any normative static stage and one optional related note per diagnostic.
    Every line must match; junk is an adapter failure.
    """
    matches = []
    harness = case["_harness"]
    source = os.path.realpath(harness["source_path"])
    case_file = os.path.realpath(harness.get("case_file", source))
    case_dir = os.path.dirname(case_file)
    expect = case.get("expect") or {}

    def resolve_reported(path):
        path = os.path.normpath(path)
        if not os.path.isabs(path):
            path = os.path.normpath(os.path.join(case_dir, path))
        return os.path.realpath(path)

    allowed_primary = {source}
    expected_primary = (expect.get("primary") or {}).get("file")
    if isinstance(expected_primary, str):
        allowed_primary.add(resolve_reported(expected_primary))
    for entry in expect.get("related") or []:
        if isinstance(entry, dict) and isinstance(entry.get("file"), str):
            allowed_primary.add(resolve_reported(entry["file"]))
    for line in text.splitlines():
        if not line.strip():
            continue
        offset_note = OFFSET_NOTE_RE.match(line)
        if offset_note:
            if not matches:
                raise RuntimeError(f"unexpected byte-offset note: {line!r}")
            last = matches[-1]
            if last["match"].group("stage") != "LEX":
                raise RuntimeError(
                    "byte-offset note is only valid for a LEX diagnostic"
                )
            note_file = resolve_reported(offset_note.group("file"))
            primary_file = resolve_reported(last["match"].group("file"))
            if (
                note_file != primary_file
                or offset_note.group("line") != last["match"].group("line")
                or offset_note.group("column") != last["match"].group("column")
            ):
                raise RuntimeError(
                    "byte-offset note file/line/column differs from the "
                    "diagnostic primary position"
                )
            if last.get("byte_offset") is not None:
                raise RuntimeError("more than one byte-offset note for a diagnostic")
            last["byte_offset"] = int(offset_note.group("offset"))
            continue
        note = NOTE_RE.match(line)
        if note:
            if mode != "static" or not matches:
                raise RuntimeError(f"unexpected note line: {line!r}")
            if matches[-1]["related"] is not None:
                raise RuntimeError("more than one related note for a diagnostic")
            matches[-1]["related"] = note
            continue
        match = DIAG_RE.match(line)
        if not match:
            raise RuntimeError(
                f"unrecognized stderr line from tc-vm: {line!r}"
            )
        reported = resolve_reported(match.group("file"))
        if reported not in allowed_primary:
            raise RuntimeError(
                f"diagnostic file {match.group('file')!r} is not the expected "
                "case or module file"
            )
        stage = match.group("stage")
        code = match.group("code")
        if mode == "syntax":
            if stage not in {"LEX", "SYN"}:
                raise RuntimeError(
                    f"tc-vm reported a non-LEX/SYN stage: {stage}"
                )
            if code not in LEX_SYN_CODES:
                raise RuntimeError(
                    f"tc-vm reported a non-LEX/SYN code: {code}"
                )
        matches.append({"match": match, "related": None, "byte_offset": None})
    return matches


def _parse_diagnostics(text, case, mode):
    """Map stable diagnostic lines to the case's metadata paths.

    Files inside the case tree are reported relative to the case file's
    directory (POSIX separators), so imported-module diagnostics can be
    asserted without exposing absolute build paths.
    """
    matches = _strict_diagnostics(text, case, mode)
    harness = case["_harness"]
    source = os.path.realpath(harness["source_path"])
    case_file = os.path.realpath(harness.get("case_file", source))
    case_dir = os.path.dirname(case_file)

    def rel(path):
        path = os.path.normpath(path)
        if not os.path.isabs(path):
            path = os.path.normpath(os.path.join(case_dir, path))
        path = os.path.realpath(path)
        if path == source:
            return case["source"]
        return os.path.relpath(path, case_dir).replace(os.sep, "/")

    diagnostics = []
    for entry in matches:
        match = entry["match"]
        related = []
        if entry["related"] is not None:
            related.append(
                {
                    "file": rel(entry["related"].group("file")),
                    "line": int(entry["related"].group("line")),
                    "column": int(entry["related"].group("column")),
                }
            )
        diagnostics.append(
            {
                "stage": match.group("stage"),
                "code": match.group("code"),
                "primary": {
                    "file": rel(match.group("file")),
                    "line": int(match.group("line")),
                    "column": int(match.group("column")),
                },
                "related": related,
                "byte_offset": entry["byte_offset"],
            }
        )
    return diagnostics


class Adapter:
    def _static_check(self, case, mode):
        harness = case["_harness"]
        source = harness["source_path"]
        timeout = harness.get("timeout_s", 10.0)
        argv = [TC_VM, "--syntax-only" if mode == "syntax" else "--static-only"]
        profile = case.get("profile")
        if isinstance(profile, str) and profile not in {"common", "w64"}:
            argv.append(f"--profile={profile}")
        for root in harness.get("include_roots", []):
            argv.append(f"--include={root}")
        argv.append(source)
        proc = _run(argv, timeout)
        if proc.stdout:
            raise RuntimeError(
                f"tc-vm {argv[1]} wrote to stdout in static mode: "
                f"{proc.stdout!r}"
            )
        if proc.returncode == 1:
            diagnostics = _parse_diagnostics(
                proc.stderr.decode("utf-8", "replace"), case, mode
            )
            if len(diagnostics) == 0:
                raise RuntimeError(
                    "tc-vm exited 1 without a parseable diagnostic"
                )
            return diagnostics
        if proc.returncode == 0:
            if proc.stderr:
                raise RuntimeError(
                    "tc-vm accepted the source but wrote to stderr: "
                    f"{proc.stderr!r}"
                )
            return []
        raise RuntimeError(
            f"tc-vm {argv[1]} failed with exit {proc.returncode}: "
            f"{proc.stderr.decode('utf-8', 'replace')}"
        )

    def run(self, case):
        harness = case["_harness"]
        source = harness["source_path"]
        argv = [TC_VM]
        profile = case.get("profile")
        if isinstance(profile, str) and profile not in {"common", "w64"}:
            argv.append(f"--profile={profile}")
        for root in harness.get("include_roots", []):
            argv.append(f"--include={root}")
        if case.get("checked"):
            argv.append("--checked")
        if case.get("opt") is not None:
            argv.append(f"--opt={case['opt']}")
        argv.append(source)
        stdin_bytes = bytes.fromhex(
            "".join(str(harness.get("stdin_hex", "")).split())
        )
        timeout = harness.get("timeout_s", 10.0)
        try:
            proc = subprocess.run(
                argv,
                cwd=os.getcwd(),
                input=stdin_bytes,
                capture_output=True,
                timeout=timeout,
                env={"LC_ALL": "C", "LANG": "C", "TZ": "UTC",
                     "PATH": os.environ.get("PATH", "/usr/bin:/bin")},
            )
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError(f"tc-vm timed out: {exc}") from exc
        stderr = proc.stderr.decode("utf-8", "replace")
        trap = None
        runtime_lines = []
        for line in stderr.splitlines():
            match = RT_RE.match(line)
            if match:
                runtime_lines.append(match)
            elif line.strip():
                raise RuntimeError(
                    f"tc-vm run wrote an unexpected stderr line: {line!r}"
                )
        if len(runtime_lines) > 1:
            raise RuntimeError("tc-vm emitted more than one runtime trap")
        if proc.returncode == 0:
            if runtime_lines:
                raise RuntimeError("tc-vm exited 0 with a trap diagnostic")
            trap = None
            termination = "normal"
        elif proc.returncode == 1 and len(runtime_lines) == 1:
            trap = runtime_lines[0].group("code")
            termination = "trap"
        else:
            raise RuntimeError(
                f"tc-vm run failed with exit {proc.returncode}: {stderr}"
            )
        return {
            "stdout_hex": proc.stdout.hex(),
            "trap": trap,
            "exit": proc.returncode,
            "termination": termination,
        }

    def compile(self, case):
        # The full static pipeline includes LEX/SYN and then discovers imports;
        # using it for every compile case keeps LEX/SYN stage priority and
        # imported-module diagnostics observable.  A LEX/SYN error still stops
        # the pipeline before IMPORT/SEM.
        return {"diagnostics": self._static_check(case, "static")}

    def tool(self, case):
        harness = case["_harness"]
        argv = [_tool_path(item) for item in case["tool"]["argv"]]
        source = harness.get("source_path")
        expanded = []
        for item in argv:
            if item == "@source":
                for root in harness.get("include_roots", []):
                    expanded.append(f"--include={root}")
                expanded.append(source)
            else:
                expanded.append(item)
        argv = expanded
        timeout = harness.get("timeout_s", 10.0)
        proc = _run(argv, timeout)
        return {
            "exit": proc.returncode,
            "stdout_hex": proc.stdout.hex(),
            "stderr_hex": proc.stderr.hex(),
        }

    def property(self, case):
        spec = case.get("property") or {}
        name = spec.get("name")
        if name != "lex_random":
            raise NotImplementedError(f"unknown property {name!r}")
        trials = int(spec.get("trials", 100))
        seed = int(spec.get("seed", 1))
        rng = random.Random(seed)
        workdir = case["_harness"]["workdir"]
        path = os.path.join(workdir, "fuzz.tc")
        counterexamples = []
        for trial in range(trials):
            length = rng.randrange(0, 240)
            if rng.random() < 0.5:
                data = bytes(rng.randrange(0, 256) for _ in range(length))
            else:
                alphabet = (
                    "#program#lib\nimport mstruct thenendvar const func "
                    "int32 ptr<>():=,.@///_\\-+;%0x1f2.5eu"
                )
                data = bytes(
                    ord(rng.choice(alphabet)) for _ in range(length)
                )
            with open(path, "wb") as handle:
                handle.write(data)
            try:
                proc = _run([TC_VM, "--syntax-only", path], 5.0)
            except subprocess.TimeoutExpired:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "timeout"}
                )
                continue
            if proc.returncode not in (0, 1):
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "exit": proc.returncode,
                     "stderr": proc.stderr.decode("utf-8", "replace")}
                )
                continue
            if proc.stdout:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "stdout in LEX/SYN mode",
                     "stdout": proc.stdout.hex()}
                )
                continue
            text = proc.stderr.decode("utf-8", "replace")
            if proc.returncode == 0:
                if text:
                    counterexamples.append(
                        {"trial": trial, "seed": seed, "hex": data.hex(),
                         "reason": "stderr without diagnostic", "stderr": text}
                    )
                continue
            try:
                fake = {
                    "_harness": {"case_file": path, "source_path": path},
                    "source": path,
                }
                lines = _strict_diagnostics(text, fake, "syntax")
            except RuntimeError as exc:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": str(exc), "stderr": text}
                )
                continue
            if len(lines) != 1:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "not exactly one diagnostic", "stderr": text}
                )
                continue
            if (lines[0]["match"].group("stage") not in {"LEX", "SYN"} or
                lines[0]["match"].group("code") not in LEX_SYN_CODES):
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "non-LEX/SYN stage or code", "stderr": text}
                )
        try:
            os.unlink(path)
        except OSError:
            pass
        return counterexamples


ADAPTER = Adapter()
