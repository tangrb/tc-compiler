#!/usr/bin/env python3
"""S1 harness adapter for the TC 0.0.46 front-end.

Generated by CMake from tests/adapters/tc_adapter.py.in; the tool paths are the
ones built in this build tree.  The adapter never guesses compiler output: it
runs `tc-vm --syntax-only` (the S1 partial LEX/SYN check) and parses the stable
diagnostic line

    <file>:<line>:<column>: error[<STAGE>]: <CODE>: <PRINT_NAME>

Tool cases use `@source` as the placeholder for the case source file.
"""

from __future__ import annotations

import os
import random
import re
import subprocess

TC_VM = r"@TC_VM_PATH@"
TC_AOT = r"@TC_AOT_PATH@"
REPO_ROOT = r"@CMAKE_SOURCE_DIR@"

DIAG_RE = re.compile(
    r"^(?P<file>.*):(?P<line>[0-9]+):(?P<column>[0-9]+): "
    r"error\[(?P<stage>LEX|SYN|IMPORT|SEM|CT)\]: "
    r"(?P<code>TC_(?:CE|RE)_[A-Z0-9_]+): (?P<name>[^:\n]*)$"
)
LEX_SYN_CODES = {
    "TC_CE_SYNTAX",
    "TC_CE_MISSING_END",
    "TC_CE_MODULE_LAYER",
    "TC_CE_MISSING_VISIBILITY",
    "TC_CE_PROGRAM_MODE_MISUSE",
    "TC_CE_VAR_MISSING_INIT",
    "TC_CE_LITERAL_LEX_RANGE",
}


def _tool_path(argv0):
    if argv0 == "tc-vm":
        return TC_VM
    if argv0 == "tc-aot":
        return TC_AOT
    return argv0


def _run(argv, timeout):
    return subprocess.run(
        argv,
        cwd=os.getcwd(),
        capture_output=True,
        timeout=timeout,
        env={"LC_ALL": "C", "LANG": "C", "TZ": "UTC",
             "PATH": os.environ.get("PATH", "/usr/bin:/bin")},
    )


def _strict_diagnostics(text, expected_path=None):
    """Parse stderr strictly.

    Every non-empty line must be a recognized diagnostic line.  S1 has no
    related positions, so `note:` lines are not accepted here; a future stage
    that emits them must extend this function explicitly.  Returns the list of
    regex matches (one per diagnostic).  Raises RuntimeError on junk.
    """
    matches = []
    expected = os.path.normpath(expected_path) if expected_path else None
    for line in text.splitlines():
        if not line.strip():
            continue
        match = DIAG_RE.match(line)
        if not match:
            raise RuntimeError(
                f"unrecognized stderr line from tc-vm: {line!r}"
            )
        reported = os.path.normpath(match.group("file"))
        if expected is not None and reported != expected:
            raise RuntimeError(
                f"tc-vm reported a diagnostic for {reported!r}, "
                f"expected {expected!r}"
            )
        stage = match.group("stage")
        code = match.group("code")
        if stage not in {"LEX", "SYN"}:
            raise RuntimeError(
                f"tc-vm reported a non-LEX/SYN stage in S1: {stage}"
            )
        if code not in LEX_SYN_CODES:
            raise RuntimeError(f"tc-vm reported a non-LEX/SYN code in S1: {code}")
        matches.append(match)
    return matches


def _parse_diagnostics(text, case):
    """Parse and map the stable diagnostic lines for a compile case.

    The adapter substitutes the case's metadata `source` string in the result
    (the harness compares that string), but only after `_strict_diagnostics`
    verified that the compiler actually reported the case source file.  A
    diagnostic from another file or any junk line is an adapter failure, never
    a pass.
    """
    matches = _strict_diagnostics(text, case["_harness"]["source_path"])
    diagnostics = []
    for match in matches:
        diagnostics.append(
            {
                "stage": match.group("stage"),
                "code": match.group("code"),
                "primary": {
                    "file": case["source"],
                    "line": int(match.group("line")),
                    "column": int(match.group("column")),
                },
                "related": [],
            }
        )
    return diagnostics


class Adapter:
    def _syntax_only(self, case):
        harness = case["_harness"]
        source = harness["source_path"]
        timeout = harness.get("timeout_s", 10.0)
        proc = _run([TC_VM, "--syntax-only", source], timeout)
        if proc.stdout:
            raise RuntimeError(
                "tc-vm --syntax-only wrote to stdout in LEX/SYN mode: "
                f"{proc.stdout!r}"
            )
        if proc.returncode == 1:
            diagnostics = _parse_diagnostics(
                proc.stderr.decode("utf-8", "replace"), case
            )
            if len(diagnostics) == 0:
                raise RuntimeError(
                    "tc-vm exited 1 without a parseable LEX/SYN diagnostic"
                )
            return diagnostics
        if proc.returncode == 0:
            if proc.stderr:
                raise RuntimeError(
                    "tc-vm accepted the source but wrote to stderr: "
                    f"{proc.stderr!r}"
                )
            return []
        raise RuntimeError(
            f"tc-vm --syntax-only failed with exit {proc.returncode}: "
            f"{proc.stderr.decode('utf-8', 'replace')}"
        )

    def compile(self, case):
        return {"diagnostics": self._syntax_only(case)}

    def tool(self, case):
        harness = case["_harness"]
        argv = [_tool_path(item) for item in case["tool"]["argv"]]
        source = harness.get("source_path")
        argv = [source if item == "@source" else item for item in argv]
        timeout = harness.get("timeout_s", 10.0)
        proc = _run(argv, timeout)
        return {
            "exit": proc.returncode,
            "stdout_hex": proc.stdout.hex(),
            "stderr_hex": proc.stderr.hex(),
        }

    def property(self, case):
        spec = case.get("property") or {}
        name = spec.get("name")
        if name != "lex_random":
            raise NotImplementedError(f"unknown property {name!r}")
        trials = int(spec.get("trials", 100))
        seed = int(spec.get("seed", 1))
        rng = random.Random(seed)
        workdir = case["_harness"]["workdir"]
        path = os.path.join(workdir, "fuzz.tc")
        counterexamples = []
        for trial in range(trials):
            length = rng.randrange(0, 240)
            if rng.random() < 0.5:
                data = bytes(rng.randrange(0, 256) for _ in range(length))
            else:
                alphabet = (
                    "#program#lib\nimport mstruct thenendvar const func "
                    "int32 ptr<>():=,.@///_\\-+;%0x1f2.5eu"
                )
                data = bytes(
                    ord(rng.choice(alphabet)) for _ in range(length)
                )
            with open(path, "wb") as handle:
                handle.write(data)
            try:
                proc = _run([TC_VM, "--syntax-only", path], 5.0)
            except subprocess.TimeoutExpired:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "timeout"}
                )
                continue
            if proc.returncode not in (0, 1):
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "exit": proc.returncode,
                     "stderr": proc.stderr.decode("utf-8", "replace")}
                )
                continue
            if proc.stdout:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "stdout in LEX/SYN mode",
                     "stdout": proc.stdout.hex()}
                )
                continue
            text = proc.stderr.decode("utf-8", "replace")
            if proc.returncode == 0:
                if text:
                    counterexamples.append(
                        {"trial": trial, "seed": seed, "hex": data.hex(),
                         "reason": "stderr without diagnostic", "stderr": text}
                    )
                continue
            try:
                lines = _strict_diagnostics(text, path)
            except RuntimeError as exc:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": str(exc), "stderr": text}
                )
                continue
            if len(lines) != 1:
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "not exactly one diagnostic", "stderr": text}
                )
                continue
            if (lines[0].group("stage") not in {"LEX", "SYN"} or
                lines[0].group("code") not in LEX_SYN_CODES):
                counterexamples.append(
                    {"trial": trial, "seed": seed, "hex": data.hex(),
                     "reason": "non-LEX/SYN stage or code", "stderr": text}
                )
        try:
            os.unlink(path)
        except OSError:
            pass
        return counterexamples


ADAPTER = Adapter()
