#program
; 附录 A field_access：标识符的分类由**名称解析**决定，没有大小写规则。
; 首字母大写的变量 `A` 作为字段访问基址（`A.i.v`）必须正常解析。
struct Inner then
    var v: int32
end
struct Outer then
    var i: Inner
end
var inner: Inner = Inner(v: 1)
var A: Outer = Outer(i: inner)
var a: Outer = Outer(i: inner)
writeln(int32, A.i.v)
writeln(int32, a.i.v)
