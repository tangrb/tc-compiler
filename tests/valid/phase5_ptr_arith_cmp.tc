#program
; Phase 5：ptr_add / ptr_eq / ptr_lt / ptr_size
var a: int32 = 1
var b: int32 = 2
var p: ptr<int32> = ptr_address(int32, a)
var q: ptr<int32> = ptr_address(int32, b)
var r: ptr<int32> = ptr_add(int32, p, 1)
var is_same: bool = ptr_eq(int32, r, q)
var is_less: bool = ptr_lt(int32, p, q)
var sz: usize = ptr_size(int32, p)
writeln(bool, is_same)
writeln(bool, is_less)
writeln(usize, sz)
