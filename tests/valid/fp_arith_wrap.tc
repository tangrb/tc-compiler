; 浮点 wrap 模式：bits 作整数回绕算术 + abs/neg 位操作
var a: float32 = 1.0
var b: float32 = 2.0

; wrap add: 0x3F800000 + 0x40000000 → 0x7F800000 → inf as float32
var add_r: float32 = add(float32, wrap, a, b)
writeln(float32, add_r)

; wrap sub: 0x40000000 - 0x3F800000 → 0x00800000 → 1.17549e-38
var sub_r: float32 = sub(float32, wrap, b, a)
writeln(float32, sub_r)

; wrap neg: 0 - 0x3F800000 → 0xC0800000 → -4.0 as float32
var neg_r: float32 = neg(float32, wrap, a)
writeln(float32, neg_r)

; wrap abs: clear sign bit
var neg_one: float32 = -1.0
var abs_r: float32 = abs(float32, wrap, neg_one)
writeln(float32, abs_r)
