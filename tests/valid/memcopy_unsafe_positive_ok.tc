#program
; Major 3 对照：memcopy_unsafe 合法用法（index 0 / length 1）与 usize 变量下标
; 不得被负下标拦截误伤（整块 memblock 对象拷贝，§6.8.9）。
var a: memblock<int32, 4> = memblock(int32, count: 4, 1, 2, 3, 4)
var b: memblock<int32, 4> = memblock(int32, count: 4, fill: 0)
var pa: ptr<memblock<int32, 4>> = ptr_address(memblock<int32, 4>, a)
var pb: ptr<memblock<int32, 4>> = ptr_address(memblock<int32, 4>, b)
var idx: usize = 0u
var v0: int32 = 0
var v1: int32 = 0
memcopy_unsafe(memblock<int32, 4>, pb, idx, pa, 0, 1)
v0 = memblock_load(int32, b, 0)
v1 = memblock_load(int32, b, 3)
writeln(int32, v0)
writeln(int32, v1)
