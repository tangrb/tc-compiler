#program
; 完整单层常量布尔条件必须裁剪 if 的不可能边
let TEN: int32 = 10
let FIVE: int32 = 5
let FLAG_A: bool = true
let FLAG_B: bool = false
var value: int32 = 0
var pending: bool = false
var result: int32 = 0
if gt(int32, TEN, FIVE) then
    value = 10
end
pending = true
if and(bool, FLAG_A, FLAG_B) then
    writeln(bool, %t, pending)
end
result = add(int32, value, 1)
writeln(int32, %d, result)
