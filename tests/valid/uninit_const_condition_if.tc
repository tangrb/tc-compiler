#program
; 完整单层常量布尔条件必须裁剪 if 的不可能边
let TEN: int32 = 10
let FIVE: int32 = 5
let FLAG_A: bool = true
let FLAG_B: bool = false
goto branch
var value: int32 = 0
label branch:
if gt(int32, TEN, FIVE) then
    value = 10
end
goto pending_use
var pending: bool = true
label pending_use:
if and(bool, FLAG_A, FLAG_B) then
    writeln(bool, %t, pending)
end
var result: int32 = add(int32, value, 1)
writeln(int32, %d, result)
