; 浮点 truncate cast：位重解释 float32↔int32、float64↔int64
var f32: float32 = 1.0
var i32: int32 = cast(int32, truncate, f32)
writeln(int32, i32)

; int32 位模式重解释回 float32
var bits_to_f32: int32 = 1065353216
var f32_back: float32 = cast(float32, truncate, bits_to_f32)
writeln(float32, f32_back)

; float64 ↔ int64
var f64: float64 = 1.0
var i64: int64 = cast(int64, truncate, f64)
writeln(int64, i64)

; int64 位模式重解释回 float64
var bits_to_f64: int64 = 4607182418800017408
var f64_back: float64 = cast(float64, truncate, bits_to_f64)
writeln(float64, f64_back)

; float64 → float32 truncate：保留低 32 位（非数值转换）
var one_f64: float64 = 1.0
var f32_from_f64: float32 = cast(float32, truncate, one_f64)
writeln(float32, f32_from_f64)

; float32 → float64 truncate：低 32 位零扩展
var pi_bits: int32 = 1078530011
var pi_f32: float32 = cast(float32, truncate, pi_bits)
var pi_f64_low: float64 = cast(float64, truncate, pi_f32)
var pi_back: float32 = cast(float32, truncate, pi_f64_low)
writeln(float32, pi_back)

; -0.0 位模式重解释（int32 0x80000000 → float32）
var neg_zero_bits: int32 = -2147483648
var neg_zero: float32 = cast(float32, truncate, neg_zero_bits)
writeln(float32, neg_zero)

; NaN 位模式重解释（int32 0x7FC00000 → float32 quiet NaN）
var nan_bits: int32 = 2143289344
var nan_f32: float32 = cast(float32, truncate, nan_bits)
writeln(float32, nan_f32)

; ====== 边界测试 ======

; 【边界1】float32 零 → int32: bit pattern 0x00000000
var f32_zero: float32 = 0.0
var i32_zero: int32 = cast(int32, truncate, f32_zero)
writeln(int32, i32_zero)

; 【边界2】int32 +inf 位模式 (0x7F800000 = 2139095040) → float32
var inf_bits_i32: int32 = 2139095040
var f32_inf_via_bits: float32 = cast(float32, truncate, inf_bits_i32)
; 验证回读到 int32
var i32_inf_back: int32 = cast(int32, truncate, f32_inf_via_bits)
writeln(int32, i32_inf_back)

; 【边界3】int32 -inf 位模式 (0xFF800000 = -8388608) → float32 → 回读
var neg_inf_bits_i32: int32 = -8388608
var f32_neg_inf_via_bits: float32 = cast(float32, truncate, neg_inf_bits_i32)
var i32_neg_inf_back: int32 = cast(int32, truncate, f32_neg_inf_via_bits)
writeln(int32, i32_neg_inf_back)

; 【边界4】int32 0 → float32: bit pattern 0x00000000 → 0.0
var i32_src0: int32 = 0
var f32_from0: float32 = cast(float32, truncate, i32_src0)
writeln(float32, f32_from0)

; 【边界5】int32 1 → float32: bit pattern 0x00000001 → 最小正非规格化数
var i32_src1: int32 = 1
var f32_from1: float32 = cast(float32, truncate, i32_src1)
writeln(float32, f32_from1)

; 【边界6】int32 最大值 (0x7FFFFFFF) → float32: signaling NaN
var i32_max: int32 = 2147483647
var f32_from_max: float32 = cast(float32, truncate, i32_max)
writeln(float32, f32_from_max)

; 【边界7】float64 零 → int64: 0
var f64_zero: float64 = 0.0
var i64_zero: int64 = cast(int64, truncate, f64_zero)
writeln(int64, i64_zero)

; 【边界8】float64 +inf (0x7FF0000000000000 = 9218868437227405312) → int64
var f64_inf: float64 = inf
var i64_inf: int64 = cast(int64, truncate, f64_inf)
writeln(int64, i64_inf)

; 【边界9】float64 -inf (0xFFF0000000000000 = -4503599627370496) → int64
var f64_neg_inf: float64 = -inf
var i64_neg_inf: int64 = cast(int64, truncate, f64_neg_inf)
writeln(int64, i64_neg_inf)

; 【边界10】int64 0 → float64: 0.0
var i64_src0: int64 = 0
var f64_from0: float64 = cast(float64, truncate, i64_src0)
writeln(float64, f64_from0)

; 【边界11】int64 +inf 位模式 (0x7FF0000000000000) → float64
var inf_bits_i64: int64 = 9218868437227405312
var f64_via_inf_bits: float64 = cast(float64, truncate, inf_bits_i64)
; 验证回读到 int64
var i64_inf_back: int64 = cast(int64, truncate, f64_via_inf_bits)
writeln(int64, i64_inf_back)

; 【边界12】int64 -inf 位模式 (0xFFF0000000000000 = -4503599627370496) → float64 → 回读
var neg_inf_bits_i64: int64 = -4503599627370496
var f64_via_neg_inf_bits: float64 = cast(float64, truncate, neg_inf_bits_i64)
var i64_neg_inf_back: int64 = cast(int64, truncate, f64_via_neg_inf_bits)
writeln(int64, i64_neg_inf_back)

; 【边界13】int64 -1 (0xFFFFFFFFFFFFFFFF) → float64: NaN
var i64_neg1: int64 = -1
var f64_from_neg1: float64 = cast(float64, truncate, i64_neg1)
writeln(float64, f64_from_neg1)

; 【边界14】int64 最大值 (0x7FFFFFFFFFFFFFFF) → float64: NaN
var i64_max_val: int64 = 9223372036854775807
var f64_from_i64_max: float64 = cast(float64, truncate, i64_max_val)
writeln(float64, f64_from_i64_max)
