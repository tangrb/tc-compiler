#program
; 跨模块执行：static let 各运算位置字段读（拓扑）+ static var 运行期字段读
import struct_field_static_topo_ops
var vnn: int32 = funcall(struct_field_static_topo_ops.get_nn)
var vbw: int32 = funcall(struct_field_static_topo_ops.get_bw)
var vsh: int32 = funcall(struct_field_static_topo_ops.get_sh)
var vlb: bool = funcall(struct_field_static_topo_ops.get_lb)
var vln: bool = funcall(struct_field_static_topo_ops.get_ln)
var vfa: float64 = funcall(struct_field_static_topo_ops.get_fa)
var vfc: bool = funcall(struct_field_static_topo_ops.get_fc)
var vcc: int8 = funcall(struct_field_static_topo_ops.get_cc)
var vbc: float32 = funcall(struct_field_static_topo_ops.get_bc)
var vsv: int32 = funcall(struct_field_static_topo_ops.get_sv)
var vsp: int32 = funcall(struct_field_static_topo_ops.get_sp_a)
var vsv2: int32 = funcall(struct_field_static_topo_ops.get_sv2)
writeln(int32, vnn)
writeln(int32, vbw)
writeln(int32, vsh)
writeln(bool, vlb)
writeln(bool, vln)
writeln(float64, vfa)
writeln(bool, vfc)
writeln(int8, vcc)
writeln(float32, vbc)
writeln(int32, vsv)
writeln(int32, vsp)
writeln(int32, vsv2)
