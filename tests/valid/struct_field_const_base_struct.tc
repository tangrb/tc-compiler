#program
; let 基址的 struct 字段整体读出。
; AOT 将 const 复合值按字节内联并深拷贝。改副本不得改写 const 基址字段（值语义）。
struct Inner then
    var v: int32
end
struct Outer then
    var inner: Inner
end
let inner0: Inner = Inner(v: 11)
let o: Outer = Outer(inner: inner0)
var x: Inner = o.inner
var back: Inner = o.inner
writeln(int32, x.v)
x.v = 99
back = o.inner
writeln(int32, back.v)
