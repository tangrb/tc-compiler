#program
; const memblock 构造 + 运行期 load + .count（AOT 路径③：无槽位 const 绑定折叠声明 count）
let mb: memblock<int32, 2> = memblock(int32, count: 2, 10, 20)
var x: int32 = memblock_load(int32, mb, 0)
var y: int32 = memblock_load(int32, mb, 1)
var c: usize = mb.count
writeln(int32, x)
writeln(int32, y)
writeln(usize, c)
