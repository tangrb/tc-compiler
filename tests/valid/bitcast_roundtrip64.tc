#program
; 64 位 bitcast 保留完整 NaN payload 与最高位
var payload: uint64 = 0x7FF8000000001234u
var payload_float: float64 = bitcast(float64, payload)
var payload_back: uint64 = bitcast(uint64, payload_float)
var high_bit: uint64 = 0x8000000000000000u
var neg_zero: float64 = bitcast(float64, high_bit)
var high_bit_back: uint64 = bitcast(uint64, neg_zero)
writeln(uint64, %X, payload_back)

writeln(uint64, %X, high_bit_back)
