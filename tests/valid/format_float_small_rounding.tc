#program
; B-46 / §10.4：十进制输出以精确数学值为输入按 roundTiesToEven 舍入——
; 需要保留的有效位落在首位有效数字之前（keep < 0）时恒舍入为零
var a: float64 = 0.00009
var b: float64 = 9.094947017729282e-13
var c: float64 = 6e-8
var d: float64 = 9e-7
writeln(float64, %.3f, a)
writeln(float64, %.0f, b)
writeln(float64, %.6f, c)
writeln(float64, %.6f, d)
