#program
; 测试所有格式说明符在各种类型上的输出
; int8
var a: int8 = 65
var b: int8 = -128
var ua: uint8 = 255
var c: int16 = -32768
var uc: uint16 = 65535
var d: int32 = -2147483648
var ud: uint32 = 4294967295
var e: int64 = -9223372036854775808
var ue: uint64 = 18446744073709551615
var truth: bool = true
var falsehood: bool = false
var f32: float32 = 1.5
var f64: float64 = 3.14159265
writeln(int8, %d, a)
writeln(int8, %d, b)
writeln(int8, %i, b)
writeln(int8, %x, a)
writeln(int8, %X, a)
writeln(int8, %o, a)
writeln(int8, %b, a)

; uint8
writeln(uint8, %u, ua)
writeln(uint8, %x, ua)
writeln(uint8, %X, ua)
writeln(uint8, %o, ua)
writeln(uint8, %b, ua)

; int16
writeln(int16, %d, c)
writeln(int16, %x, c)
writeln(int16, %X, c)

; uint16
writeln(uint16, %u, uc)
writeln(uint16, %x, uc)
writeln(uint16, %X, uc)
writeln(uint16, %o, uc)
writeln(uint16, %b, uc)

; int32
writeln(int32, %d, d)
writeln(int32, %x, d)
writeln(int32, %X, d)
writeln(int32, %o, d)
writeln(int32, %b, d)

; uint32
writeln(uint32, %u, ud)
writeln(uint32, %x, ud)
writeln(uint32, %X, ud)
writeln(uint32, %o, ud)
writeln(uint32, %b, ud)

; int64
writeln(int64, %d, e)
writeln(int64, %x, e)
writeln(int64, %X, e)

; uint64
writeln(uint64, %u, ue)
writeln(uint64, %x, ue)
writeln(uint64, %X, ue)
writeln(uint64, %o, ue)
writeln(uint64, %b, ue)

; bool
writeln(bool, %t, truth)
writeln(bool, %t, falsehood)

; float32/float64 的五种格式
writeln(float32, %f, f32)
writeln(float32, %e, f32)
writeln(float32, %E, f32)
writeln(float32, %g, f32)
writeln(float32, %G, f32)

writeln(float64, %f, f64)
writeln(float64, %e, f64)
writeln(float64, %E, f64)
writeln(float64, %g, f64)
writeln(float64, %G, f64)

; write 不换行，writeln 只追加一个 LF
write(int8, %d, a)
write(bool, %t, truth)
writeln(float64, %g, f64)
