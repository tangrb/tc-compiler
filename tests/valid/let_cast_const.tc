#program
; let 编译期常量 cast 操作（仅 int↔int 允许 const_cast）
let a: int8 = cast(int8, 42)
let b: int32 = cast(int32, a)
let c: int32 = cast(int32, 255)
let d: uint32 = cast(uint32, c)
let e: int64 = cast(int64, -100)
let f: uint64 = cast(uint64, 1000)
writeln(int8, a)               ; 42

writeln(int32, b)              ; 42

writeln(int32, c)              ; 255

writeln(uint32, d)             ; 255

writeln(int64, e)              ; -100

writeln(uint64, f)             ; 1000
