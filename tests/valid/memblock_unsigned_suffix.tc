#program
; `memblock` 的 N 与 count: 接受带 u/U 后缀的整数字面量
; （语言标准 §2.3.1、§3.8.1）
var a: memblock<int32, 4u> = memblock(int32, count: 4u, 1, 2, 3, 4)
var b: memblock<uint8, 2U> = memblock(uint8, count: 2U, 7, 8)
var va: int32 = memblock_load(int32, a, 3)
var vb: uint8 = memblock_load(uint8, b, 1)
var n: usize = a.count
writeln(int32, va)
writeln(uint8, vb)
writeln(usize, n)
