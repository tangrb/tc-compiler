#program
; 测试字面量边界情况
; 超大十进制字面量
var a: uint64 = 18446744073709551615
var b: uint32 = 4000000000u
var c: uint8 = 200u
var d: uint64 = 0xFF_FF_FF_FF_FF_FF_FF_FFu
var e: uint32 = 0x7F_FF_FF_FF
var f: uint16 = 0b1010_0101_1111_0000
var g: uint8 = 0b1111_0000
var h: uint32 = 0o777_777_7777
var i: uint16 = 0o177_777
var k: uint8 = 0b1111_1111u
var l: int8 = 100
var m: int8 = sub(int8, l, 50)
var n: int8 = sub(int8, l, 100)
var q: int8 = -128
var r: int16 = -32768
var s: int32 = -2147483648
writeln(uint64, a)

; 无符号后缀
writeln(uint32, b)
writeln(uint8, c)

; 多进制 + 下划线组合
writeln(uint64, d)
writeln(uint32, e)
writeln(uint16, f)
writeln(uint8, g)
writeln(uint32, h)
writeln(uint16, i)

; 二进制+无符号后缀
writeln(uint8, k)

; 减法中的字面量直接使用（装得下的值）
writeln(int8, m)
writeln(int8, n)

; 负数字面量边界
writeln(int8, q)
writeln(int16, r)
writeln(int32, s)
