#program
; §3.9.1 / §3.10：ptr<B>（B 更早定义）字段 + ptr_address / ptr_load / ptr_store 往返
struct B then
    var x: int32
end
struct A then
    var p: ptr<B>
end
var b: B = B(x: 42)
var pb: ptr<B> = ptr_address(B, b)
var a: A = A(p: pb)
var p: ptr<B> = a.p
var v: B = ptr_load(B, p)
var w: int32 = v.x
var b2: B = B(x: 99)
var w2: int32 = 0
writeln(int32, w)
ptr_store(B, p, b2)
w2 = b.x
writeln(int32, w2)
