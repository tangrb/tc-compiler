#program
; E-03：精确非规格化结果合法（禁止 FTZ；不报 underflow）
; min_normal * 0.5 → exact subnormal 0x0008000000000000
var min_normal: float64 = bitcast(float64, 0x0010000000000000u)
var half: float64 = bitcast(float64, 0x3FE0000000000000u)
var a: float64 = mul(float64, min_normal, half)
var bits: uint64 = bitcast(uint64, a)
writeln(uint64, %X, bits)
