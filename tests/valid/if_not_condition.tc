#program
; if 使用 not 逻辑非作为条件
var x: int32 = 5

; not(bool, true_lit) → false → else
var is_eq: bool = false
var is_lt: bool = false
if not(bool, true) then
    writeln(int32, -1)
else
    writeln(int32, 1)         ; 1
end

; not(bool, false_lit) → true → then
if not(bool, false) then
    writeln(int32, 2)         ; 2
else
    writeln(int32, -2)
end

; 使用 bool 变量作为 not 的操作数
is_eq = eq(int32, x, 10)    ; false
is_lt = lt(int32, x, 3)     ; false

; not(bool, false_var) → true → then
if not(bool, is_eq) then
    writeln(int32, 3)         ; 3
end

; not(bool, false_var) → true → then
if not(bool, is_lt) then
    writeln(int32, 4)         ; 4
end
