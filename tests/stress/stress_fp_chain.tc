#program
; stress: 长链浮点 let + 嵌套 cast
; 验证编译期折叠 + 运行时精度稳定性
let A: float64 = 3.141592653589793
let B: float64 = mul(float64, 2.0, A)
let C: float64 = add(float64, B, 1.0)
let D: float64 = sub(float64, C, 0.5)
let E: float64 = div(float64, D, 2.0)
let F: bool = lt(float64, E, 4.0)
let TMP: float64 = sub(float64, E, 3.0)
let G: float64 = abs(float64, TMP)
var H: float32 = cast(float32, G)
var I: int32 = cast(int32, H)
var sum: float64 = 0.0
sum = add(float64, sum, A)
sum = add(float64, sum, B)
sum = add(float64, sum, C)
sum = add(float64, sum, D)
sum = add(float64, sum, E)
sum = div(float64, sum, 6.0)
writeln(float64, A)
writeln(float64, B)
writeln(float64, C)
writeln(float64, D)
writeln(float64, E)
writeln(bool, F)
writeln(float64, G)
writeln(float32, H)
writeln(int32, I)
writeln(float64, sum)
