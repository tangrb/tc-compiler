write(int32, %x, fmt_src)
write(int32, %X, fmt_src)
write(int32, %o, fmt_src)
write(int32, %b, fmt_src)
var fmt_src_u: uint32 = 255
write(uint32, %u, fmt_src_u)
write(uint32, %x, fmt_src_u)
writeln(int32, 0)
