writeln(int32, cast_to32)
writeln(int64, cast_to64)
writeln(uint16, cast_to_u16)
writeln(uint32, cast_to_u32)
writeln(uint64, cast_to_u64)
writeln(bool, cast_bool_from_i8)
writeln(int8, cast_i8_from_bool)
