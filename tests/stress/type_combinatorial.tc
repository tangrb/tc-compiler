; === cast operations across types ===
var cast_src8: int8 = -100
var cast_to16: int16 = cast(int16, cast_src8)
var cast_to32: int32 = cast(int32, cast_to16)
var cast_to64: int64 = cast(int64, cast_to32)
var cast_src_u: int32 = 200
var cast_u8: uint8 = cast(uint8, cast_src_u)
var cast_to_u16: uint16 = cast(uint16, cast_u8)
var cast_to_u32: uint32 = cast(uint32, cast_to_u16)
var cast_to_u64: uint64 = cast(uint64, cast_to_u32)
var cast_bool_from_i8: bool = cast(bool, cast_src8)
var cast_bool_src: bool = true
var cast_i8_from_bool: int8 = cast(int8, cast_bool_src)
