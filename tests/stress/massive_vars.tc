; Stress test: ~200 variable definitions with arithmetic operations
; Tests symbol table lookup performance and executor scalability

; ======== int8 chain ========
var a0: int8 = 10
var a1: int8 = add(int8, wrap, a0, 20)
var a2: int8 = add(int8, wrap, a1, 30)
var a3: int8 = add(int8, wrap, a2, 40)
var a4: int8 = add(int8, wrap, a3, 50)
var a5: int8 = add(int8, wrap, a4, 60)
var a6: int8 = add(int8, wrap, a5, 70)
var a7: int8 = add(int8, wrap, a6, 80)
var a8: int8 = add(int8, wrap, a7, 90)
var a9: int8 = add(int8, wrap, a8, 100)

; ======== int16 chain ========
var b0: int16 = 100
var b1: int16 = add(int16, b0, 200)
var b2: int16 = add(int16, b1, 300)
var b3: int16 = add(int16, b2, 400)
var b4: int16 = add(int16, b3, 500)
var b5: int16 = add(int16, b4, 600)
var b6: int16 = add(int16, b5, 700)
var b7: int16 = add(int16, b6, 800)
var b8: int16 = add(int16, b7, 900)
var b9: int16 = add(int16, b8, 1000)

; ======== int32 chain ========
var c0: int32 = 10000
