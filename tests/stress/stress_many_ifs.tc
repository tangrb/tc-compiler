; 压力测试：大量独立 if 语句（20 个）
var result: int32 = 0

if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end

; result should be 10 now

if false then
    result = 0
end

; result should still be 10

if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end
if true then
    result = add(int32, result, 1)
end

; total should be 20
writeln(int32, result)         ; 20

; 混合 if-else
var count: int32 = 0
if true then
    count = add(int32, count, 1)
else
    count = sub(int32, count, 1)
end
if false then
    count = sub(int32, count, 1)
else
    count = add(int32, count, 1)
end
if true then
    count = add(int32, count, 1)
else
    count = sub(int32, count, 1)
end
if false then
    count = sub(int32, count, 1)
else
    count = add(int32, count, 1)
end
if true then
    count = add(int32, count, 1)
end

; count = 1 + 1 + 1 + 1 + 1 = 5
writeln(int32, count)          ; 5
