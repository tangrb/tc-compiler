# Normalize line endings for text files.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Byte-exact LEX/SYN fixtures: CRLF/CR and invalid-byte tests must keep their
# working-tree bytes (the generator writes them with newline="").
tests/conformance/static/accept/crlf.tc -text
tests/conformance/static/accept/lone_cr.tc -text
tests/conformance/static/lex/crlf_position.tc -text
tests/conformance/static/lex/lone_cr_position.tc -text
